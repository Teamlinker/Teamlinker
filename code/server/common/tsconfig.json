{
  "compilerOptions": {
    "outDir": "./dist",
    "module": "commonjs",
    "target": "ES2017",
    "sourceMap": true,
    "resolveJsonModule":true,
    "moduleResolution":"node",
    "noImplicitUseStrict":true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noImplicitOverride": true,
    "baseUrl": "./",
  },
  "include": [
    "./**/*",
    "../../common/**/*"
 ],
  "exclude": [
    "node_modules"
  ]
}