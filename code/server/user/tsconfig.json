{
    "compilerOptions": {
      "outDir": "./dist",
      "module": "commonjs",
      "target": "ES2017",
      "sourceMap": true,
      "resolveJsonModule":true,
      "moduleResolution":"node",
      "noImplicitUseStrict":true,
      "experimentalDecorators": true,
      "emitDecoratorMetadata": true,
      "baseUrl": "./",
      "plugins": [
        { "transform": "../../common/transform/transformer.js" }
      ]
    },
    "include": [
      "./**/*"
    ],
    "exclude": [
      "node_modules"
    ]
  }