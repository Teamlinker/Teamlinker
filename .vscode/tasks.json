{
	"version": "2.0.0",
	"tasks": [
		{
			"type": "typescript",
			"tsconfig": "code/server/gateway/tsconfig.json",
			"problemMatcher": [
				"$tsc"
			],
			"group": "build",
			"label": "gateway-tsc"
		},
		{
			"label": "gateway-clean",
			"type": "shell",
			"command": "rm",
			"args": [
				"-rf",
				"code/server/gateway/dist"
			]
		},
		{
			"label": "gateway-build",
			"dependsOn": [
				"gateway-clean",
				"gateway-tsc"
			]
		}
	]
}